# Base Model
BASE_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# LoRA Adapter Paths (relative to backend/ folder)
# Opposing Counsel weights live at repo root: ../models/opposing-counsel/
PREMISE_ADAPTER_PATH=../models/premise-generator
OPPOSING_COUNSEL_ADAPTER_PATH=../models/opposing-counsel
OBJECTION_ADAPTER_PATH=../models/objection-evaluator

# Inference Settings
USE_4BIT=false
DEFAULT_MAX_NEW_TOKENS=300
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_REPETITION_PENALTY=1.1

# Hugging Face Hub (SSL / offline). If you see SSL errors, try TRUST_REMOTE_CODE=false first.
LOCAL_FILES_ONLY=false
TRUST_REMOTE_CODE=false
HF_DISABLE_SSL_VERIFY=false
