# Database
DATABASE_URL=sqlite+aiosqlite:///./juriscode.db

# GGUF Models (relative to project root)
# The code resolves these relative to the project root
PREMISE_GGUF_PATH=../models/premise_generator_Q4_K_M.gguf
OPPOSING_GGUF_PATH=../models/opposing_counsel_Q4_K_M.gguf
MODEL_N_CTX=4096
MODEL_N_GPU_LAYERS=-1

# Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
